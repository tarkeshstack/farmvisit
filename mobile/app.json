{
  "expo": {
    "name": "Farm Visit",
    "slug": "farmvisit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0d2a25",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b7466"
    },
    "android": {
      "package": "com.tarkeshstack.farmvisit",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b7466"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.tarkeshstack.farmvisit",
      "supportsTablet": true
    }
  }
}
